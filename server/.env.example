# Copy to .env and fill in. Never commit .env.
# Generate both keys with: python scripts/make_keys.py
AGENT_KEY=
HELPER_KEY=
MY_EMAIL=you@gmail.com
# Where reminder/status emails go. An @icloud.com address arrives instantly on iPhone.
NOTIFY_EMAIL=you@icloud.com
# Your cell number. Setting it turns on Google Voice texting; texts from other numbers are ignored.
OWNER_PHONE=
TIMEZONE=America/Los_Angeles
GEMINI_API_KEY=
# If Google retires this model, pick a current free "flash" model from ai.google.dev
GEMINI_MODEL=gemini-3.8-flash
DB_PATH=agent.db
# Hosted database (Render deploy). When TURSO_DATABASE_URL is set, DB_PATH is ignored.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
GMAIL_TOKEN_PATH=token.json
# Render deploy: paste the whole contents of token.json here instead of uploading the file
GMAIL_TOKEN_JSON=
# Fine-grained token with Contents: read/write on ONE repo, e.g. you/agent-generated-code
GITHUB_TOKEN=
GITHUB_REPO=
DIGEST_TIME=07:30
HEADS_UP_HOURS=24
